# Satark Saathi Development Environment Configuration
ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000

# PostgreSQL Configuration
POSTGRES_DB=satark_db
POSTGRES_USER=satark_user
POSTGRES_PASSWORD=satark_password
DATABASE_URL=postgresql+asyncpg://satark_user:satark_password@localhost:5432/satark_db
SYNC_DATABASE_URL=postgresql+psycopg://satark_user:satark_password@localhost:5432/satark_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=dev_secret_key_change_in_production
